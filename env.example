# Copie este arquivo para .env em ambiente local (nunca comite o .env de verdade).
# No Railway, essas mesmas chaves vão em Settings > Variables, não em arquivo.

SIENGE_SUBDOMINIO=monter
SIENGE_USUARIO=usuario-de-integracao
SIENGE_SENHA=senha-de-integracao

# Domínio(s) que podem chamar este proxy, separados por vírgula.
# Use * apenas para testar - em produção, restrinja ao domínio do GitHub Pages.
ALLOWED_ORIGIN=https://leonardoblucena.github.io
